# This checkout doubles as the host's ~/Projects: project repos, scratch clones, secrets
# (.env.<stack>), jail state (.claude-data*, .codex-jail/) and the composed CLAUDE.local.md
# all sit at the top level. So the top level is an ALLOWLIST: everything is ignored except
# claude-jail's own files below. A new top-level file or directory needs a `!` line here.
/*
!/.aliases
!/.claude/
!/.dockerignore
!/.gitignore
!/.hadolint.yaml
!/CLAUDE.md
!/Dockerfile
!/README.md
!/devbox.json
!/devbox.lock
!/docker-compose*.yml
!/setup-env.sh
!/tools/

# Inside the allowed paths
.claude/settings.local.json
__pycache__/
*.pyc
.env
.env.*
.idea/
